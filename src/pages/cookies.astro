---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Poola Cookie Policy";
const description = "How Poola may use essential, preference and analytics cookies.";
---

<BaseLayout title={title} description={description}>
  <section class="page-hero policy-hero"><div class="stripe-field stripe-field--small" aria-hidden="true"><span></span><span></span><span></span></div><div class="container page-hero__grid"><div data-reveal><p class="signal"><span></span> Cookies</p><h1>Cookie policy.</h1><p class="hero__sub">How Poola may use cookies and similar technologies to keep the product working and improve the experience.</p></div></div></section>
  <section class="section"><div class="container policy-layout"><aside class="policy-toc" data-reveal><h2>Legal links</h2><a href="terms.html">Terms and conditions</a><a href="privacy.html">Privacy policy</a><a class="is-active" href="cookies.html">Cookie policy</a><a href="refund-policy.html">Funding and refunds</a><a href="delete-account.html">Delete account</a></aside><div class="policy-content" data-reveal><article class="policy-card"><h2>Cookies and similar technology</h2><p>Poola may use cookies, local storage and similar technologies to remember settings, protect sessions and understand whether the website and product are working well.</p><h3>Types of cookies</h3><ul><li><strong>Essential:</strong> required for security, navigation, account sessions and core product features.</li><li><strong>Preference:</strong> used to remember choices such as display, language or consent settings.</li><li><strong>Analytics:</strong> used to understand traffic, performance and feature quality in aggregate.</li></ul><h3>Managing cookies</h3><p>Browser settings can block or delete cookies. Some essential features may stop working if required cookies are disabled.</p><div class="policy-meta"><span>Last updated June 13, 2026</span><span>No sale of personal data</span></div></article></div></div></section>
</BaseLayout>
