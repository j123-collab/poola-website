---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Poola Community Guidelines";
const description = "Community guidelines for Pool Starters and Poolers on Poola.";
---

<BaseLayout title={title} description={description}>
  <section class="page-hero policy-hero"><div class="stripe-field stripe-field--small" aria-hidden="true"><span></span><span></span><span></span></div><div class="container page-hero__grid"><div data-reveal><p class="signal"><span></span> Community</p><h1>Community guidelines.</h1><p class="hero__sub">The baseline for honest Pools, respectful participation and safer People Power.</p></div></div></section>
  <section class="section"><div class="container policy-layout"><aside class="policy-toc" data-reveal><h2>Trust links</h2><a href="trust-status.html">Trust status</a><a href="safety.html">Safety center</a><a class="is-active" href="community-guidelines.html">Community guidelines</a><a href="security.html">Security</a><a href="accessibility.html">Accessibility</a></aside><div class="policy-content" data-reveal><article class="policy-card"><h2>How to participate</h2><p>Poola is for people trying to move useful ideas, causes and projects forward. Participation should be honest, specific and safe.</p><h3>Allowed behavior</h3><ul><li>Start Pools with accurate goals, context and contribution requests.</li><li>Offer skills, time, resources, signatures, attendance or funds in good faith.</li><li>Ask questions, share updates and disagree without harassment.</li></ul><h3>Not allowed</h3><ul><li>Fraud, impersonation, misleading fundraising or hidden conflicts of interest.</li><li>Harassment, hate, threats, doxxing, exploitation or unsafe volunteer requests.</li><li>Spam, malware, manipulated engagement or attempts to bypass safety systems.</li></ul><h3>Moderation</h3><p>Poola may remove content, pause Pools, limit accounts or escalate reports when guidelines are broken.</p><div class="policy-meta"><span>Last updated June 13, 2026</span><span>Community support: info@poola.io</span></div></article></div></div></section>
</BaseLayout>
