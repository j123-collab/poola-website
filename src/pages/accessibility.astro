---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Poola Accessibility";
const description = "Poola accessibility commitment and feedback contact.";
---

<BaseLayout title={title} description={description}>
  <section class="page-hero policy-hero"><div class="stripe-field stripe-field--small" aria-hidden="true"><span></span><span></span><span></span></div><div class="container page-hero__grid"><div data-reveal><p class="signal"><span></span> Accessibility</p><h1>Accessibility.</h1><p class="hero__sub">Poola should be usable by people with different devices, abilities and ways of navigating.</p></div></div></section>
  <section class="section"><div class="container policy-layout"><aside class="policy-toc" data-reveal><h2>Trust links</h2><a href="trust-status.html">Trust status</a><a href="safety.html">Safety center</a><a href="community-guidelines.html">Community guidelines</a><a href="security.html">Security</a><a class="is-active" href="accessibility.html">Accessibility</a></aside><div class="policy-content" data-reveal><article class="policy-card"><h2>Accessibility commitment</h2><p>Poola aims to make the website and product clear, keyboard-friendly, responsive and readable.</p><h3>What Poola works toward</h3><ul><li>Semantic HTML and useful page structure.</li><li>Keyboard-accessible navigation and controls.</li><li>Readable contrast, scalable layouts and responsive pages.</li><li>Alt text for meaningful images and clear labels for interactive controls.</li></ul><h3>Feedback</h3><p>If something is hard to use, confusing with assistive technology or visually difficult to read, email <a href="mailto:info@poola.io">info@poola.io</a> with “Accessibility” in the subject.</p><div class="policy-meta"><span>Last updated June 13, 2026</span><span>Feedback: info@poola.io</span></div></article></div></div></section>
</BaseLayout>
