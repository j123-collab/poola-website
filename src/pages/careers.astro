---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Poola Careers";
const description = "Careers and future team opportunities at Poola.";
---

<BaseLayout title={title} description={description}>
  <section class="page-hero policy-hero"><div class="stripe-field stripe-field--small" aria-hidden="true"><span></span><span></span><span></span></div><div class="container page-hero__grid"><div data-reveal><p class="signal"><span></span> Careers</p><h1>Build Poola.</h1><p class="hero__sub">Future roles for people who care about trust, community products and practical crowd-sourcing.</p></div></div></section>
  <section class="section"><div class="container policy-layout"><aside class="policy-toc" data-reveal><h2>Company links</h2><a href="index.html#about">About</a><a href="contributors.html">Contributors</a><a href="investors.html">Investors</a>
        <a href="partners.html">Partners</a><a href="contact.html">Contact</a><a href="press.html">Press</a><a class="is-active" href="careers.html">Careers</a></aside><div class="policy-content" data-reveal><article class="policy-card"><h2>No open roles yet</h2><p>Poola is still early. This page gives the company a normal careers home now, and can become a real hiring page when roles are ready.</p><h3>Future areas</h3><ul><li>Product engineering for web, mobile and payments.</li><li>Trust, safety and moderation operations.</li><li>Community launch and partnerships.</li><li>Design, research and creator tooling.</li></ul><h3>General interest</h3><p>For now, send short introductions to <a href="mailto:info@poola.io?subject=Poola%20careers">info@poola.io</a>. Open roles and application instructions can be added here later.</p><div class="policy-meta"><span>Open roles coming later</span><span>Last updated June 13, 2026</span></div></article></div></div></section>
</BaseLayout>
