---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Poola Press";
const description = "Poola press information, story angles and media contact.";
---

<BaseLayout title={title} description={description}>
  <section class="page-hero policy-hero"><div class="stripe-field stripe-field--small" aria-hidden="true"><span></span><span></span><span></span></div><div class="container page-hero__grid"><div data-reveal><p class="signal"><span></span> Press</p><h1>Press room.</h1><p class="hero__sub">A short media home for Poola’s story, product direction and contact path.</p></div></div></section>
  <section class="section"><div class="container policy-layout"><aside class="policy-toc" data-reveal><h2>Company links</h2><a href="index.html#about">About</a><a href="contributors.html">Contributors</a><a href="investors.html">Investors</a>
        <a href="partners.html">Partners</a><a href="contact.html">Contact</a><a class="is-active" href="press.html">Press</a><a href="careers.html">Careers</a></aside><div class="policy-content" data-reveal><article class="policy-card"><h2>About Poola</h2><p>Poola is a crowd-sourcing platform for funds and People Power. Instead of treating support as only money, Poola brings skills, time, resources, signatures, attendance, voice, updates and campaign management into one Pool.</p><h3>Story angles</h3><ul><li>Why crowdfunding needs a broader contribution model.</li><li>How local communities can turn news and urgency into action.</li><li>Why trust, reporting and transparent updates matter in public campaigns.</li><li>How Poola can help social good, creators and startups use the same engine.</li></ul><h3>Media contact</h3><p>Email <a href="mailto:info@poola.io?subject=Poola%20press">info@poola.io</a> for press requests, screenshots and background.</p><div class="policy-meta"><span>Press kit coming soon</span><span>Last updated June 13, 2026</span></div></article></div></div></section>
</BaseLayout>
