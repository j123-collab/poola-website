---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Poola Explore - Poolers and Pool Starters"
  description="Explore how Poola works for Poolers and Pool Starters with role-specific flows, features, examples and next steps."
>
  <div class="explore-page" id="explore-switchboard" data-explore-switch>
    <section class="explore-hero">
      <div class="container explore-hero__inner">
        <div class="explore-hero__intro">
          <h1 data-explore-title>Explore as a</h1>
          <div class="explore-toggle" role="radiogroup" aria-label="Choose Explore audience">
            <button type="button" role="radio" aria-checked="false" data-explore-mode-button="poolers">
              Pooler
            </button>
            <button type="button" role="radio" aria-checked="false" data-explore-mode-button="starters">
              Pool Starter
            </button>
          </div>
          <p class="hero__sub" data-explore-copy>
            Find Pools worth joining, read the trust state, contribute in the way you can and keep seeing what happened next.
          </p>
        </div>

        <aside class="explore-role-map" aria-label="Interactive Poola role flow">
          <div class="explore-role-map__chrome">
            <span>Poola</span>
            <strong data-explore-badge>Join path</strong>
          </div>

          <div class="explore-role-map__canvas">
            <div class="explore-role-map__core" aria-hidden="true">
              <span>Pool</span>
              <small>Funds + People Power</small>
            </div>

            <div class="explore-role-map__nodes">
              <article class="explore-role-node" data-node="1">
                <span><i class="fa-solid fa-magnifying-glass" data-explore-map-icon="0"></i></span>
                <strong data-explore-map-title="0">Discover</strong>
                <p data-explore-map-copy="0">Find active Pools by cause, place, creator, urgency or trust state.</p>
              </article>
              <article class="explore-role-node" data-node="2">
                <span><i class="fa-solid fa-shield-heart" data-explore-map-icon="1"></i></span>
                <strong data-explore-map-title="1">Trust</strong>
                <p data-explore-map-copy="1">Read what is verified, pending, funded, promised and still open.</p>
              </article>
              <article class="explore-role-node" data-node="3">
                <span><i class="fa-solid fa-hand-holding-heart" data-explore-map-icon="2"></i></span>
                <strong data-explore-map-title="2">Contribute</strong>
                <p data-explore-map-copy="2">Back with money, skills, resources, time, voice or useful connections.</p>
              </article>
              <article class="explore-role-node" data-node="4">
                <span><i class="fa-solid fa-bell" data-explore-map-icon="3"></i></span>
                <strong data-explore-map-title="3">Follow</strong>
                <p data-explore-map-copy="3">Stay close to updates, blockers, milestones and community asks.</p>
              </article>
              <article class="explore-role-node" data-node="5">
                <span><i class="fa-solid fa-circle-check" data-explore-map-icon="4"></i></span>
                <strong data-explore-map-title="4">Verify</strong>
                <p data-explore-map-copy="4">Check proof, completion notes and the next visible trust state.</p>
              </article>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="section explore-role-detail">
      <div class="container explore-role-detail__grid">
        <div class="explore-flow-meta" data-reveal>
          <p class="eyebrow" data-explore-badge>Join path</p>
          <h2 data-explore-panel-title>From discovery to visible impact.</h2>
          <p data-explore-panel-copy>
            Poolers need a simple way to decide whether a Pool is real, useful and worth helping. Poola keeps the reason,
            request, progress and proof in one place.
          </p>
          <a class="btn btn--secondary" href="trust-status.html" data-explore-cta>Security and trust</a>
        </div>

        <div class="explore-flow" aria-live="polite">
          <article data-reveal>
            <i class="fa-solid fa-magnifying-glass" data-explore-step-icon="0"></i>
            <span data-explore-step-kicker="0">01</span>
            <h3 data-explore-step-title="0">Discover Pools</h3>
            <p data-explore-step-copy="0">Find active Pools by cause, place, creator, urgency or trust state.</p>
          </article>
          <article data-reveal>
            <i class="fa-solid fa-shield-heart" data-explore-step-icon="1"></i>
            <span data-explore-step-kicker="1">02</span>
            <h3 data-explore-step-title="1">Read the trust state</h3>
            <p data-explore-step-copy="1">See what is verified, pending, funded, promised and still open.</p>
          </article>
          <article data-reveal>
            <i class="fa-solid fa-hand-holding-heart" data-explore-step-icon="2"></i>
            <span data-explore-step-kicker="2">03</span>
            <h3 data-explore-step-title="2">Choose your contribution</h3>
            <p data-explore-step-copy="2">Back with money, skills, resources, time, voice or useful connections.</p>
          </article>
          <article data-reveal>
            <i class="fa-solid fa-bell" data-explore-step-icon="3"></i>
            <span data-explore-step-kicker="3">04</span>
            <h3 data-explore-step-title="3">Follow updates</h3>
            <p data-explore-step-copy="3">Stay close to blockers, milestones, new asks and delivery notes.</p>
          </article>
          <article data-reveal>
            <i class="fa-solid fa-circle-check" data-explore-step-icon="4"></i>
            <span data-explore-step-kicker="4">05</span>
            <h3 data-explore-step-title="4">Verify the outcome</h3>
            <p data-explore-step-copy="4">Check proof, completion notes and the next visible trust state.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section explore-capabilities">
      <div class="container section-head section-head--center" data-reveal>
        <p class="eyebrow" data-explore-badge>Join path</p>
        <h2 data-explore-feature-title>Tools for people deciding whether to help.</h2>
        <p data-explore-feature-copy>
          Poolers need clarity before contributing and a visible trail after they do.
        </p>
      </div>

      <div class="container explore-feature-grid" aria-live="polite">
        <article data-reveal>
          <i class="fa-solid fa-compass" data-explore-card-icon="0"></i>
          <p data-explore-card-tag="0">Discover</p>
          <h3 data-explore-card-title="0">Better browsing</h3>
          <span data-explore-card-copy="0">Filter by topic, location, contribution type, urgency and trust status.</span>
        </article>
        <article data-reveal>
          <i class="fa-solid fa-scale-balanced" data-explore-card-icon="1"></i>
          <p data-explore-card-tag="1">Decide</p>
          <h3 data-explore-card-title="1">Clearer commitments</h3>
          <span data-explore-card-copy="1">Compare what is needed, why it matters and who is accountable.</span>
        </article>
        <article data-reveal>
          <i class="fa-solid fa-hand-holding-heart" data-explore-card-icon="2"></i>
          <p data-explore-card-tag="2">Contribute</p>
          <h3 data-explore-card-title="2">More ways to help</h3>
          <span data-explore-card-copy="2">Support with funds, skills, materials, volunteers, spaces or audience.</span>
        </article>
        <article data-reveal>
          <i class="fa-solid fa-eye" data-explore-card-icon="3"></i>
          <p data-explore-card-tag="3">Follow</p>
          <h3 data-explore-card-title="3">Visible follow-through</h3>
          <span data-explore-card-copy="3">Watch updates, proof, changes and outcomes after the first contribution.</span>
        </article>
      </div>
    </section>

    <section class="section explore-examples" id="example-pools">
      <div class="container section-head section-head--center" data-reveal>
        <p class="eyebrow">Example Pools</p>
        <h2 data-explore-example-title>Pools a Pooler can understand quickly.</h2>
        <p data-explore-example-copy>
          Examples show how different causes ask for funds, skills, time, resources and voice without hiding the trust state.
        </p>
      </div>

      <div class="container explore-example-grid" aria-live="polite">
        <article data-reveal>
          <p data-explore-example-tag="0">Local action</p>
          <h3 data-explore-example-title-item="0">Neighbourhood playground repair</h3>
          <span data-explore-example-copy-item="0">
            See the budget, volunteer roles, contractor quotes and proof milestones before helping.
          </span>
          <div class="explore-example-card__pills" data-explore-example-pills="0">
            <b>Funds</b><b>Time</b><b>Proof</b>
          </div>
        </article>
        <article data-reveal>
          <p data-explore-example-tag="1">Creator</p>
          <h3 data-explore-example-title-item="1">Community film launch</h3>
          <span data-explore-example-copy-item="1">
            Follow what the creator needs, who is joining and how backers will see progress.
          </span>
          <div class="explore-example-card__pills" data-explore-example-pills="1">
            <b>Skills</b><b>Audience</b><b>Updates</b>
          </div>
        </article>
        <article data-reveal>
          <p data-explore-example-tag="2">Social good</p>
          <h3 data-explore-example-title-item="2">Community kitchen relaunch</h3>
          <span data-explore-example-copy-item="2">
            Check partner roles, open shifts, delivery notes and the state of each promised resource.
          </span>
          <div class="explore-example-card__pills" data-explore-example-pills="2">
            <b>Resources</b><b>Shifts</b><b>Trust</b>
          </div>
        </article>
        <article data-reveal>
          <p data-explore-example-tag="3">Start up</p>
          <h3 data-explore-example-title-item="3">Open pilot validation</h3>
          <span data-explore-example-copy-item="3">
            Back a pilot with feedback, introductions, testing time or early support.
          </span>
          <div class="explore-example-card__pills" data-explore-example-pills="3">
            <b>Validate</b><b>Feedback</b><b>Follow</b>
          </div>
        </article>
      </div>
    </section>

    <section class="section final-cta explore-cta">
      <div class="container final-cta__inner" data-reveal>
        <p class="eyebrow" data-explore-badge>Join path</p>
        <h2 data-explore-final-title>Find a Pool, choose your help, follow the proof.</h2>
        <p data-explore-final-copy>
          Poola is designed so the person helping does not have to guess what happened after they contributed.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="trust-status.html" data-explore-final-primary>Explore trust</a>
          <a class="btn btn--secondary" href="pool-starters.html" data-explore-final-secondary>Start a Pool</a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .explore-page {
      --explore-accent: #087a86;
      --explore-accent-2: #0f8ff2;
      --explore-warm: #f7c75e;
      --explore-soft: rgba(119, 213, 220, 0.22);
      --explore-line: rgba(7, 123, 134, 0.2);
      background:
        radial-gradient(circle at 50% 0%, rgba(118, 218, 224, 0.18), transparent 34rem),
        linear-gradient(180deg, rgba(245, 252, 253, 0.92), #fff 44rem);
    }

    .explore-page[data-explore-mode="starters"] {
      --explore-accent: #1744d8;
      --explore-accent-2: #ff7a57;
      --explore-soft: rgba(40, 113, 245, 0.15);
      --explore-line: rgba(23, 68, 216, 0.2);
    }

    .explore-page:not([data-explore-mode="poolers"]):not([data-explore-mode="starters"]) .hero__sub,
    .explore-page:not([data-explore-mode="poolers"]):not([data-explore-mode="starters"]) .explore-role-map,
    .explore-page:not([data-explore-mode="poolers"]):not([data-explore-mode="starters"]) .explore-role-detail,
    .explore-page:not([data-explore-mode="poolers"]):not([data-explore-mode="starters"]) .explore-capabilities,
    .explore-page:not([data-explore-mode="poolers"]):not([data-explore-mode="starters"]) .explore-examples,
    .explore-page:not([data-explore-mode="poolers"]):not([data-explore-mode="starters"]) .explore-cta {
      display: none;
    }

    .explore-hero {
      min-height: calc(100svh - 7rem);
      display: flex;
      align-items: center;
      padding: clamp(6rem, 10vw, 9rem) 0 clamp(4rem, 8vw, 6rem);
      overflow: hidden;
    }

    .explore-hero__inner {
      display: grid;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }

    .explore-hero__intro {
      max-width: 58rem;
      margin: 0 auto;
      text-align: center;
    }

    .explore-hero__intro .signal {
      justify-content: center;
      margin-bottom: 1.1rem;
    }

    .explore-hero h1 {
      margin: 1.35rem auto 0;
      max-width: 13ch;
      font-size: clamp(4rem, 8vw, 7.8rem);
      line-height: 0.9;
      letter-spacing: 0;
    }

    .explore-hero .hero__sub {
      max-width: 48rem;
      margin: 1.3rem auto 0;
    }

    .explore-toggle {
      position: relative;
      width: min(100%, 24rem);
      max-width: 100%;
      margin: 1.15rem auto 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.28rem;
      padding: 0.34rem;
      border: 1px solid rgba(66, 201, 210, 0.32);
      border-radius: 999px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(244, 253, 254, 0.72)),
        rgba(255, 255, 255, 0.72);
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, 0.72),
        0 1.2rem 3rem rgba(8, 21, 26, 0.08);
      backdrop-filter: blur(18px);
      isolation: isolate;
      view-transition-name: explore-role-toggle;
    }

    .explore-toggle::before {
      content: "";
      position: absolute;
      z-index: 0;
      top: 0.34rem;
      bottom: 0.34rem;
      left: 0.34rem;
      width: calc((100% - 0.96rem) / 2);
      border-radius: 999px;
      background:
        radial-gradient(circle at 50% 18%, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.5) 36%, transparent 68%),
        rgba(255, 255, 255, 0.96);
      box-shadow:
        inset 0 0 0 1px rgba(8, 21, 26, 0.08),
        0 0.85rem 1.8rem rgba(8, 21, 26, 0.08);
      opacity: 0.82;
      transform: translateX(calc(50% + 0.14rem)) scaleX(0.24);
      transform-origin: center;
      transition:
        opacity 180ms ease,
        box-shadow 180ms ease,
        transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .explore-page[data-explore-mode="poolers"] .explore-toggle::before,
    .explore-page[data-explore-mode="starters"] .explore-toggle::before {
      opacity: 1;
      transform: translateX(0) scaleX(1);
      box-shadow:
        inset 0 0 0 1px rgba(8, 21, 26, 0.08),
        0 0.85rem 1.8rem rgba(8, 21, 26, 0.08),
        0 0 0 5px color-mix(in srgb, var(--explore-accent) 10%, transparent);
    }

    .explore-page[data-explore-mode="starters"] .explore-toggle::before {
      transform: translateX(calc(100% + 0.28rem)) scaleX(1);
    }

    .explore-toggle button {
      position: relative;
      z-index: 1;
      appearance: none;
      border: 0;
      min-height: 2.8rem;
      padding: 0 1.25rem;
      border-radius: 999px;
      background: transparent;
      color: var(--muted);
      font-weight: 900;
      cursor: pointer;
      transition:
        color 180ms ease,
        background 180ms ease,
        box-shadow 180ms ease,
        transform 180ms ease;
    }

    .explore-toggle button:hover,
    .explore-toggle button:focus-visible {
      color: var(--ink);
    }

    .explore-toggle button:focus-visible {
      outline: 3px solid rgba(83, 217, 224, 0.45);
      outline-offset: 2px;
    }

    .explore-toggle button.is-active {
      color: var(--ink);
    }

    .explore-role-map {
      position: relative;
      width: min(100%, 74rem);
      margin: 0 auto;
      border: 1px solid rgba(8, 21, 26, 0.1);
      border-radius: 2rem;
      background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(241, 253, 255, 0.68)),
        radial-gradient(circle at 50% 12%, var(--explore-soft), transparent 30rem);
      box-shadow:
        0 2rem 5rem rgba(10, 31, 36, 0.12),
        inset 0 1px 0 rgba(255, 255, 255, 0.9);
      overflow: hidden;
      backdrop-filter: blur(22px);
      view-transition-name: explore-role-map;
    }

    .explore-role-map::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 18% 22%, rgba(255, 255, 255, 0.75), transparent 11rem),
        radial-gradient(circle at 78% 10%, rgba(255, 255, 255, 0.55), transparent 13rem);
      pointer-events: none;
    }

    .explore-role-map__chrome {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.35rem;
      border-bottom: 1px solid rgba(8, 21, 26, 0.08);
      color: var(--explore-accent);
      text-transform: uppercase;
      letter-spacing: 0;
      font-size: 0.76rem;
      font-weight: 950;
    }

    .explore-role-map__chrome strong {
      color: var(--muted);
      text-transform: none;
      font-size: 0.86rem;
    }

    .explore-role-map__canvas {
      position: relative;
      z-index: 1;
      padding: clamp(1.2rem, 3vw, 2.4rem);
    }

    .explore-role-map__canvas::before {
      content: "";
      position: absolute;
      left: 8%;
      right: 8%;
      top: calc(50% + 1.2rem);
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--explore-line), var(--explore-accent), var(--explore-line), transparent);
      opacity: 0.7;
      transform: translateY(-50%);
    }

    .explore-role-map__core {
      position: relative;
      z-index: 2;
      width: clamp(9rem, 16vw, 12rem);
      aspect-ratio: 1;
      margin: 0 auto 1.6rem;
      display: grid;
      place-items: center;
      text-align: center;
      border-radius: 50%;
      color: var(--ink);
      background:
        radial-gradient(circle at 28% 24%, rgba(255, 255, 255, 0.86), transparent 28%),
        radial-gradient(circle at 62% 78%, rgba(255, 255, 255, 0.24), transparent 30%),
        linear-gradient(145deg, rgba(151, 236, 238, 0.96), rgba(30, 158, 176, 0.88));
      box-shadow:
        0 1.4rem 4rem rgba(28, 162, 177, 0.28),
        inset 0 0 0 1px rgba(255, 255, 255, 0.66),
        inset 0 -1.5rem 2rem rgba(4, 83, 102, 0.12);
      animation: exploreCoreFloat 7s ease-in-out infinite;
      view-transition-name: explore-pool-core;
    }

    .explore-role-map__core::after {
      content: "";
      position: absolute;
      inset: 0.8rem;
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: inherit;
      pointer-events: none;
    }

    .explore-role-map__core span {
      display: block;
      font-size: clamp(1.9rem, 3.4vw, 3rem);
      line-height: 1;
      font-weight: 950;
    }

    .explore-role-map__core small {
      display: block;
      max-width: 8rem;
      margin: 0.45rem auto 0;
      color: rgba(8, 21, 26, 0.72);
      font-size: 0.78rem;
      font-weight: 900;
      line-height: 1.25;
    }

    .explore-role-map__nodes {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.8rem;
    }

    .explore-role-node {
      position: relative;
      min-height: 13.6rem;
      padding: 1rem;
      border: 1px solid rgba(8, 21, 26, 0.09);
      border-radius: 1.4rem;
      background: rgba(255, 255, 255, 0.72);
      box-shadow:
        0 1rem 2.6rem rgba(8, 21, 26, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.9);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition:
        transform 220ms ease,
        opacity 220ms ease,
        border-color 220ms ease,
        box-shadow 220ms ease;
    }

    .explore-role-node::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: linear-gradient(160deg, rgba(255, 255, 255, 0.36), transparent 58%);
      pointer-events: none;
    }

    .explore-role-node span {
      width: 2.4rem;
      height: 2.4rem;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: var(--explore-accent);
      background: color-mix(in srgb, var(--explore-accent) 13%, white);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.75);
    }

    .explore-role-node strong {
      display: block;
      margin-top: 1.2rem;
      color: var(--ink);
      font-size: clamp(1.1rem, 1.8vw, 1.35rem);
      line-height: 1.05;
    }

    .explore-role-node p {
      margin: 0.75rem 0 0;
      color: var(--muted);
      font-size: 0.93rem;
      line-height: 1.45;
    }

    .explore-page.is-changing .explore-role-node,
    .explore-page.is-changing .explore-flow article,
    .explore-page.is-changing .explore-feature-grid article,
    .explore-page.is-changing .explore-example-grid article {
      opacity: 0;
      transform: translateY(0.45rem) scale(0.99);
    }

    .explore-role-detail__grid {
      display: grid;
      grid-template-columns: minmax(16rem, 0.78fr) minmax(0, 1.45fr);
      gap: clamp(1.25rem, 3vw, 2.6rem);
      align-items: start;
    }

    .explore-role-detail {
      view-transition-name: explore-role-detail;
    }

    .explore-flow-meta {
      position: sticky;
      top: 8.5rem;
      padding: clamp(1.3rem, 2.5vw, 2rem);
      border: 1px solid rgba(8, 21, 26, 0.1);
      border-radius: 1.4rem;
      background: rgba(255, 255, 255, 0.78);
      box-shadow: 0 1.5rem 4rem rgba(8, 21, 26, 0.08);
      backdrop-filter: blur(18px);
    }

    .explore-flow-meta h2 {
      margin: 0.7rem 0 0;
      font-size: clamp(2rem, 4vw, 3.4rem);
      line-height: 0.95;
      letter-spacing: 0;
    }

    .explore-flow-meta p:not(.eyebrow) {
      margin: 1rem 0 1.4rem;
      color: var(--muted);
      font-size: 1.06rem;
      line-height: 1.7;
    }

    .explore-flow {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.8rem;
    }

    .explore-flow article,
    .explore-feature-grid article,
    .explore-example-grid article {
      min-width: 0;
      border: 1px solid rgba(8, 21, 26, 0.1);
      border-radius: 1.25rem;
      background: rgba(255, 255, 255, 0.82);
      box-shadow: 0 1.4rem 3.6rem rgba(8, 21, 26, 0.07);
      transition:
        transform 220ms ease,
        opacity 220ms ease,
        border-color 220ms ease,
        box-shadow 220ms ease;
    }

    .explore-flow article {
      position: relative;
      padding: 1rem;
      overflow: hidden;
    }

    .explore-flow article::before {
      content: "";
      position: absolute;
      top: 0;
      left: 1rem;
      right: 1rem;
      height: 2px;
      background: linear-gradient(90deg, var(--explore-accent), var(--explore-warm));
      opacity: 0.72;
    }

    .explore-flow i,
    .explore-feature-grid i {
      color: var(--explore-accent);
      font-size: 1.1rem;
    }

    .explore-flow span {
      display: block;
      margin-top: 1rem;
      color: var(--explore-accent);
      font-size: 0.78rem;
      font-weight: 950;
      text-transform: uppercase;
    }

    .explore-flow h3,
    .explore-feature-grid h3,
    .explore-example-grid h3 {
      margin: 0.45rem 0 0;
      color: var(--ink);
      font-size: 1.12rem;
      line-height: 1.12;
    }

    .explore-flow p,
    .explore-feature-grid span,
    .explore-example-grid span {
      display: block;
      margin-top: 0.75rem;
      color: var(--muted);
      line-height: 1.55;
    }

    .explore-capabilities,
    .explore-examples {
      background: linear-gradient(180deg, rgba(246, 252, 253, 0.7), rgba(255, 255, 255, 0));
    }

    .explore-capabilities {
      view-transition-name: explore-capabilities;
    }

    .explore-examples {
      view-transition-name: explore-examples;
    }

    .explore-feature-grid,
    .explore-example-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 2rem;
    }

    .explore-feature-grid article,
    .explore-example-grid article {
      padding: 1.2rem;
      background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(245, 252, 253, 0.76)),
        radial-gradient(circle at 82% 0%, var(--explore-soft), transparent 12rem);
    }

    .explore-feature-grid p,
    .explore-example-grid p {
      margin: 0.9rem 0 0;
      color: var(--explore-accent);
      font-size: 0.76rem;
      font-weight: 950;
      text-transform: uppercase;
    }

    .explore-example-card__pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 1rem;
    }

    .explore-example-card__pills b {
      display: inline-flex;
      align-items: center;
      min-height: 1.85rem;
      padding: 0 0.7rem;
      border-radius: 999px;
      color: color-mix(in srgb, var(--explore-accent) 76%, #071316);
      background: color-mix(in srgb, var(--explore-accent) 12%, white);
      font-size: 0.75rem;
      font-weight: 950;
    }

    .explore-cta {
      padding-top: clamp(2rem, 5vw, 4rem);
      view-transition-name: explore-cta;
    }

    @keyframes exploreCoreFloat {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-0.45rem);
      }
    }

    @media (max-width: 1100px) {
      .explore-role-map__nodes,
      .explore-flow,
      .explore-feature-grid,
      .explore-example-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .explore-role-map__canvas::before {
        display: none;
      }

      .explore-role-detail__grid {
        grid-template-columns: 1fr;
      }

      .explore-flow-meta {
        position: static;
      }
    }

    @media (max-width: 820px) {
      .explore-hero {
        min-height: auto;
        padding: 4.5rem 0 3rem;
      }

      .explore-hero h1 {
        font-size: clamp(3.2rem, 14vw, 5rem);
      }

      .explore-toggle {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .explore-toggle button {
        min-width: 0;
        padding: 0 0.75rem;
      }

      .explore-role-map {
        border-radius: 1.35rem;
      }

      .explore-role-map__chrome {
        align-items: flex-start;
        flex-direction: column;
      }

      .explore-role-map__nodes,
      .explore-flow,
      .explore-feature-grid,
      .explore-example-grid {
        grid-template-columns: 1fr;
      }

      .explore-role-node {
        min-height: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .explore-toggle button,
      .explore-role-map__core,
      .explore-role-node,
      .explore-flow article,
      .explore-feature-grid article,
      .explore-example-grid article {
        animation: none;
        transition: none;
      }
    }
  </style>

  <style is:global>
    @keyframes exploreViewOut {
      to {
        opacity: 0;
        transform: translateY(-0.35rem) scale(0.992);
      }
    }

    @keyframes exploreViewIn {
      from {
        opacity: 0;
        transform: translateY(0.55rem) scale(0.992);
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      ::view-transition-old(explore-role-map),
      ::view-transition-old(explore-role-detail),
      ::view-transition-old(explore-capabilities),
      ::view-transition-old(explore-examples),
      ::view-transition-old(explore-cta) {
        animation: exploreViewOut 150ms ease both;
      }

      ::view-transition-new(explore-role-map),
      ::view-transition-new(explore-role-detail),
      ::view-transition-new(explore-capabilities),
      ::view-transition-new(explore-examples),
      ::view-transition-new(explore-cta) {
        animation: exploreViewIn 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      ::view-transition-old(explore-role-toggle),
      ::view-transition-new(explore-role-toggle),
      ::view-transition-old(explore-pool-core),
      ::view-transition-new(explore-pool-core) {
        animation-duration: 220ms;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      }
    }
  </style>
</BaseLayout>
