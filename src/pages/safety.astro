---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Poola Safety Center";
const description = "Poola safety guidance for profiles, identity checks, reporting, payment trust and campaign transparency.";
---

<BaseLayout title={title} description={description}>
  <section class="page-hero policy-hero"><div class="stripe-field stripe-field--small" aria-hidden="true"><span></span><span></span><span></span></div><div class="container page-hero__grid"><div data-reveal><p class="signal"><span></span> Trust</p><h1>Safety center.</h1><p class="hero__sub">A practical home for safe Pool starting, responsible contributing and clear reporting.</p></div></div></section>
  <section class="section"><div class="container policy-layout"><aside class="policy-toc" data-reveal><h2>Trust links</h2><a href="trust-status.html">Trust status</a><a class="is-active" href="safety.html">Safety center</a><a href="community-guidelines.html">Community guidelines</a><a href="security.html">Security</a><a href="accessibility.html">Accessibility</a></aside><div class="policy-content" data-reveal><article class="policy-card"><h2>Safety principles</h2><p>Poola should make trust visible before, during and after contribution. That means clear profiles, staged checks, transparent updates and reporting tools that are easy to find.</p><h3>For Pool Starters</h3><ul><li>Explain who you are, what you need and how support will be used.</li><li>Keep updates clear when goals, timing or needs change.</li><li>Ask for People Power responsibly, with safe expectations and realistic commitments.</li></ul><h3>For Poolers</h3><ul><li>Read the Pool page, facts, updates and comments before contributing.</li><li>Report Pools or users that seem misleading, unsafe or abusive.</li><li>Use payment and communication paths that keep records visible.</li></ul><h3>How Poola can help</h3><p>Verified profiles, staged identity checks, PayPal/payment trust, reporting paths and moderation help keep the product safer without blocking good campaigns.</p><div class="policy-meta"><span>Report concerns: info@poola.io</span><span>Last updated June 13, 2026</span></div></article></div></div></section>
</BaseLayout>
